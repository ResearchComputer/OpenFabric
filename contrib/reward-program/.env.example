# OpenTela reward program launch configuration.
#
# Copy to .env before running scripts:
#   cp .env.example .env
#
# These scripts source .env with bash. Keep values shell-compatible.

# Cluster moniker or RPC URL accepted by Solana CLI.
SOLANA_CLUSTER=devnet

# Fee payer and default deploy authority.
WALLET=~/.config/solana/id.json

# Set to yes before running scripts against mainnet-beta.
CONFIRM_MAINNET=no

# ---------------------------------------------------------------------------
# Token mint script: scripts/create-token.sh
# ---------------------------------------------------------------------------

# token = classic SPL Token Program.
# token-2022 = Token Extensions Program.
# A custom program ID can be supplied with TOKEN_PROGRAM_ID.
TOKEN_PROGRAM=token
TOKEN_PROGRAM_ID=

TOKEN_DECIMALS=9
TOKEN_INITIAL_SUPPLY=1000000

# Optional existing mint. Set this to resume after a mint was already created
# or to mint initial supply/revoke authorities for a known devnet mint.
TOKEN_MINT=

# If deployments/<cluster>/token.env exists, create-token reuses that mint by
# default. Set true only when intentionally creating another mint.
FORCE_NEW_TOKEN=false

# When TOKEN_MINT is reused, initial supply minting is skipped by default to
# avoid accidental duplicate mints. Set true only to recover a partially failed
# launch or intentionally add TOKEN_INITIAL_SUPPLY again.
MINT_INITIAL_SUPPLY_ON_EXISTING=false

# Optional mint keypair. If unset, spl-token creates a random mint keypair.
TOKEN_KEYPAIR=

# Keypair that will be mint authority and initial mint signer.
TOKEN_AUTHORITY_KEYPAIR=~/.config/solana/id.json

# Recipient owner for the initial supply. Defaults to the token authority.
TOKEN_RECIPIENT=

# Freeze authority is disabled by default for a neutral public token.
ENABLE_FREEZE=false

# Irreversible authority revocation toggles.
REVOKE_MINT_AUTHORITY=false
REVOKE_FREEZE_AUTHORITY=false

# ---------------------------------------------------------------------------
# Program deploy script: scripts/deploy-program.sh
# ---------------------------------------------------------------------------

PROGRAM_NAME=opentela_rewards

# This keypair must match declare_id! in programs/opentela_rewards/src/lib.rs.
# Do not commit a production program keypair.
PROGRAM_KEYPAIR=target/deploy/opentela_rewards-keypair.json

# Extra args passed after `anchor deploy --`, for example:
#   SOLANA_DEPLOY_ARGS="--use-rpc --with-compute-unit-price 1000"
SOLANA_DEPLOY_ARGS=

# ---------------------------------------------------------------------------
# Campaign initialization script: scripts/initialize-campaign.mjs
# ---------------------------------------------------------------------------

# Program ID deployed by npm run deploy:program. If omitted, the script reads
# deployments/<cluster>/program.env or the built IDL address.
REWARD_PROGRAM_ID=

# Mint created by npm run create-token. Leave the token-script TOKEN_MINT
# setting above empty to read deployments/<cluster>/token.env.

# Base-unit payout rate per served usage unit.
REWARD_PER_UNIT=1

# OpenTela head authority that signs reward receipts. Defaults to WALLET.
HEAD_AUTHORITY=

# Optional initial funding transferred from WALLET's token account into the
# campaign vault. This is in raw token base units, not UI OTELA.
CAMPAIGN_FUND_AMOUNT_BASE_UNITS=0
